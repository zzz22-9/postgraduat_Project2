  "required": [
    "relation_id",
    "source",
    "relation",
    "target",
    "weight",
    "timestamp",
    "context"
  ],
  "title": "RelationEdge",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
